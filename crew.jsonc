{
  // Display name for this crew
  "name": "newsletter_crew",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["newsletter_reseracher", "newsletter_writer"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "research_the_five_most_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Research the five most significant developments about {topic} published in the past seven days. Use at least three different publishers; do not rely on a single company's own site. Open each article and read it before summarising. For each item give the exact publication date as YYYY-MM-DD taken from the page, the publisher, and the source link. Never write only a month or guess a date: drop any item whose exact date or link you cannot verify. If fewer than five can be verified, report only those verified.",

      // Clear definition of what the output should look like
      "expected_output": "Up to five summaries, each with a source link, the publisher, and an exact YYYY-MM-DD publication date, drawn from at least three different publishers",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "newsletter_reseracher"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "using_the_research_brief_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Using the research brief, write a newsletter about {topic} in plain language. The very first line must be 'Topic: {topic}'. Then add a title, an introduction, a section for each development with its publisher, exact publication date and source link, and a short closing note listing any items dropped because they could not be verified. Do not invent facts, dates or sources.",

      // Clear definition of what the output should look like
      "expected_output": "A polished Markdown newsletter. First line 'Topic: {topic}', then a title, short introduction, up to five news sections each with publisher, YYYY-MM-DD date and source link.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "newsletter_writer",

      // Rejects drafts that lack the topic line, exact dates or links (retries up to 2 times)
      "guardrail": "The newsletter must start with a line beginning 'Topic:', and every news item must include an exact YYYY-MM-DD publication date and a source link.",
      "guardrail_max_retries": 2,

      // Task outputs used as context
      "context": ["research_the_five_most_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "newsletter_reseracher",
  "before_kickoff_callbacks": [{"python": "callbacks.before_kickoff"}],
  // Saves newsletter_<Topic>_<date>_<time>.md in the current folder (see callbacks.py)
  "after_kickoff_callbacks": [{"python": "callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {"topic": "AI agents"}
}
